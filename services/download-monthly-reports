#!/usr/bin/env bash
set -u
set -o pipefail

usage() {
  cat <<'EOF'
Usage: ./services/download-monthly-reports --healthcheck-url-env VARIABLE [--arrival-healthcheck-url-env VARIABLE] [--host HOST] [--port PORT] [--verbose] [--help]

Runs download-monthly-reports, logs output under shoutbomb-download-monthly-reports,
and sends best-effort Healthchecks.io start/success/failure pings. A successful
poll with no new files is success. The daily check monitors polling.

Required service option:
  --healthcheck-url-env VARIABLE  Name of a HEALTHCHECKS_*_URL variable in .env

Optional service option:
  --arrival-healthcheck-url-env VARIABLE
      Separate HEALTHCHECKS_*_URL variable for monthly arrival. Only newly
      downloaded files dated in the current calendar month count, using the
      system/.env TZ timezone, not the CSV reporting period. Sends success only,
      never daily start/failure pings. Pending notifications retry during that
      same month; no-op runs after acknowledgment do not reset this check.
      Monitoring failures never replace download/logging status.
      --receipt-dir is managed by the service when this option is enabled.

Optional service setting:
  SHOUTBOMB_LOGGER_PATH           Logger executable (default: /usr/bin/logger)

Downloader options are passed unchanged to the standalone script for validation:
  -H, --host HOST
  -P, --port PORT
  -v, --verbose
  -h, --help                     Show this help text

Configuration is loaded from the project-root .env, independent of working directory.
EOF
}

healthcheck_url_env=""
arrival_healthcheck_url_env=""
download_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --healthcheck-url-env)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        echo "Error: Option $1 requires an environment variable name." >&2
        exit 2
      fi
      if [[ -n "$healthcheck_url_env" ]]; then
        echo "Error: Option $1 may only be specified once." >&2
        exit 2
      fi
      healthcheck_url_env="$2"
      shift 2
      ;;
    --arrival-healthcheck-url-env)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* || -n "$arrival_healthcheck_url_env" ]]; then
        echo "Error: Option $1 requires one environment variable name and may only be specified once." >&2
        exit 2
      fi
      arrival_healthcheck_url_env="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      download_args+=("$@")
      break
      ;;
    *)
      download_args+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$healthcheck_url_env" ]]; then
  echo "Error: Required option --healthcheck-url-env was not provided." >&2
  usage >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
# shellcheck source=services/lib/monitored-job.sh
. "$script_dir/lib/monitored-job.sh"

env_file="$project_root/.env"
if ! shoutbomb_load_env "$env_file" ||
  ! daily_url="$(resolve_healthchecks_url "$env_file" "$healthcheck_url_env")"; then
  exit 1
fi
arrival_url=""
receipt_dir="$project_root/data/monthly-reports/.arrival-state/pending"
if [[ -n "$arrival_healthcheck_url_env" ]]; then
  if ! arrival_url="$(resolve_healthchecks_url "$env_file" "$arrival_healthcheck_url_env")"; then
    exit 1
  fi
  if [[ "$arrival_url" == "$daily_url" ]]; then
    echo "Error: Daily polling and monthly arrival must use different Healthchecks.io URLs." >&2
    exit 1
  fi
  download_args+=( --receipt-dir "$receipt_dir" )
fi
start_monitoring "$daily_url"

# A subshell keeps this notification-only lock/trap separate from the daily
# lifecycle traps. Multiple wrappers may retry pending results, but only one
# consumes/acknowledges a snapshot at a time.
# Invoked indirectly by run_logged below.
# shellcheck disable=SC2317
notify_monthly_arrivals() (
  local month receipt name download_month
  local filename_pattern='^sb_generate_monthly_report_[A-Za-z0-9_-]+_([0-9]{4}-[0-9]{2})-[0-9]{2}_[0-9]{2}_[0-9]{2}_[0-9]{2}\.csv$'
  local completed_dir="$project_root/data/monthly-reports"
  local lock_dir="$completed_dir/.arrival.lock"
  local -a pending=()
  [[ -d "$receipt_dir" ]] || return 0
  if ! mkdir -- "$lock_dir" 2>/dev/null; then
    echo "Warning: Monthly notification lock unavailable; deferring arrival notification."
    return 0
  fi
  trap 'rmdir -- "$lock_dir"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  if ! month="$(date +%Y-%m)" || [[ ! "$month" =~ ^[0-9]{4}-(0[1-9]|1[0-2])$ ]]; then
    echo "Warning: Cannot determine calendar month; deferring arrival notification."
    return 0
  fi
  shopt -s nullglob
  for receipt in "$receipt_dir"/*.csv; do
    [[ -f "$receipt" && ! -L "$receipt" ]] || continue
    name="${receipt##*/}"
    [[ "$name" =~ $filename_pattern ]] || continue
    download_month="$(< "$receipt")"
    if [[ "$download_month" != "${BASH_REMATCH[1]}" || "$download_month" < "$month" ]]; then
      # Historical/future-dated backfills are not arrivals for their download
      # month; expired retries must not mask a missing report next month.
      rm -f -- "$receipt"
      continue
    fi
    if [[ "$download_month" == "$month" && -f "$completed_dir/$name" && ! -L "$completed_dir/$name" ]]; then
      pending+=("$receipt")
    fi
  done
  [[ ${#pending[@]} -gt 0 ]] || return 0
  if command -v curl >/dev/null 2>&1 &&
    curl -fsS --connect-timeout 2 --max-time 5 --retry 5 --retry-max-time 30 \
      -o /dev/null "$arrival_url" </dev/null >/dev/null 2>&1; then
    if rm -f -- "${pending[@]}"; then
      echo "Monthly arrival acknowledged: ${#pending[@]} newly downloaded report(s)."
    else
      echo "Warning: Arrival acknowledged but receipt cleanup failed; notification may repeat."
    fi
  else
    echo "Warning: Monthly arrival notification failed; pending receipts will retry this month."
  fi
)

cd -- "$project_root" || exit 1
run_logged \
  "shoutbomb-download-monthly-reports" \
  "$project_root/download-monthly-reports" \
  "${download_args[@]}"
download_status=$?
if [[ -n "$arrival_url" ]]; then
  # Completed downloads still count when another transfer or logger failed.
  # Notification and its logging are best-effort, independent of daily status.
  run_logged "shoutbomb-download-monthly-reports" notify_monthly_arrivals || true
fi
finish_monitoring "$download_status"
