#!/usr/bin/env bash
set -u
set -o pipefail

healthcheck_url_env=""
generate_report_names=()
upload_report_names=()
generate_reports_requested=0
upload_reports_requested=0

usage() {
  cat <<'EOF'
Usage: ./services/generate-and-upload --healthcheck-url-env VARIABLE [--generate-reports REPORT [REPORT ...]] [--upload-reports REPORT [REPORT ...]] [--help]

Runs generate-reports and, only when generation succeeds, runs upload.
Command output is sent to logger using the existing shoutbomb tags, and
Healthchecks.io is notified when the workflow starts and finishes.
The service loads the selected Healthchecks.io URL from ./.env in the project root.

Required service option:
  --healthcheck-url-env VARIABLE   Name of a HEALTHCHECKS_*_URL variable in ./.env

Optional service setting:
  SHOUTBOMB_LOGGER_PATH            Logger executable path (default: /usr/bin/logger)

Workflow options:
  --generate-reports REPORT [...]  Reports to pass to generate-reports
  --upload-reports REPORT [...]    Reports to pass to upload
  -h, --help                       Show this help text

If a report option is omitted, the corresponding script runs without --reports
and uses its existing default report selection.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --healthcheck-url-env)
      if [[ $# -lt 2 || "$2" == -* ]]; then
        echo "Error: Option $1 requires an environment variable name." >&2
        usage >&2
        exit 2
      fi

      if [[ -n "$healthcheck_url_env" ]]; then
        echo "Error: Option $1 may only be specified once." >&2
        usage >&2
        exit 2
      fi

      healthcheck_url_env="$2"
      shift 2
      ;;
    --generate-reports)
      generate_reports_requested=1
      shift

      if [[ $# -eq 0 || "$1" == -* ]]; then
        echo "Error: Option --generate-reports requires at least one report name." >&2
        usage >&2
        exit 2
      fi

      while [[ $# -gt 0 && "$1" != -* ]]; do
        generate_report_names+=("$1")
        shift
      done
      ;;
    --upload-reports)
      upload_reports_requested=1
      shift

      if [[ $# -eq 0 || "$1" == -* ]]; then
        echo "Error: Option --upload-reports requires at least one report name." >&2
        usage >&2
        exit 2
      fi

      while [[ $# -gt 0 && "$1" != -* ]]; do
        upload_report_names+=("$1")
        shift
      done
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$healthcheck_url_env" ]]; then
  echo "Error: Required option --healthcheck-url-env was not provided." >&2
  usage >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
env_file="$project_root/.env"

# shellcheck source=services/lib/monitored-job.sh
. "$script_dir/lib/monitored-job.sh"

if ! start_monitoring_from_env "$env_file" "$healthcheck_url_env"; then
  exit 1
fi

cd -- "$project_root" || exit 1

generate_args=()
upload_args=()

if [[ $generate_reports_requested -eq 1 ]]; then
  generate_args+=(--reports "${generate_report_names[@]}")
fi

if [[ $upload_reports_requested -eq 1 ]]; then
  upload_args+=(--reports "${upload_report_names[@]}")
fi

run_logged \
  "shoutbomb-generate-reports" \
  "$project_root/generate-reports" \
  "${generate_args[@]}"
generation_status=$?

if [[ $generation_status -ne 0 ]]; then
  finish_monitoring "$generation_status"
fi

run_logged \
  "shoutbomb-upload" \
  "$project_root/upload" \
  "${upload_args[@]}"
upload_status=$?

finish_monitoring "$upload_status"
