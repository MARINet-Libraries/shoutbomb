PGHOST=hostname
PGPORT=5432
PGDATABASE=database_name
PGUSER=username
PGPASSWORD=secret

# Required by monitored service jobs. Use a unique URL for each cron workflow:
HEALTHCHECKS_PRIMARY_REPORTS_URL=https://hc-ping.com/your-primary-reports-check-uuid
HEALTHCHECKS_RENEWALS_URL=https://hc-ping.com/your-renewals-check-uuid
HEALTHCHECKS_ARCHIVE_URL=https://hc-ping.com/your-archive-check-uuid
# Daily monthly-report polling (success does not mean a new report arrived):
HEALTHCHECKS_MONTHLY_DOWNLOAD_URL=https://hc-ping.com/your-monthly-download-check-uuid
# Separate arrival check, selected with --arrival-healthcheck-url-env:
HEALTHCHECKS_MONTHLY_ARRIVAL_URL=https://hc-ping.com/your-monthly-arrival-check-uuid
# Optional: calendar month defaults to the system timezone; match monitoring's timezone.
# TZ=Etc/UTC

# Optional logger executable override; monitored services default to /usr/bin/logger.
# This is primarily useful for isolated local tests.
# SHOUTBOMB_LOGGER_PATH=/usr/bin/logger

SSH_HOST=ftp.shoutbomb.com
SSH_PORT=22
SSH_USERNAME=your_username
# Use absolute paths for SSH files:
SSH_IDENTITY_FILE=/full/path/to/private_key
# Optional:
# SSH_KNOWN_HOSTS_FILE=/full/path/to/known_hosts
