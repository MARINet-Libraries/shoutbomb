#!/usr/bin/env bash
set -u

mock_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tests/mocks/mock-lib.bash
. "$mock_dir/mock-lib.bash"

call_dir="$(mock_begin_call sftp)"
mock_record_args "$call_dir/args" "$@"
cat > "$call_dir/stdin"

{
  printf '%s\n' "--- call $(basename -- "$call_dir") args ---"
  printf '%s\n' "$@"
  printf '%s\n' "--- stdin ---"
  cat "$call_dir/stdin"
} >> "$MOCK_STATE_DIR/sftp/transcript"

input="$(cat "$call_dir/stdin")"
get_pattern='^@get "(/monthly_report/[^"]+)" "(.*)"$'
download_target=""
if [[ "$input" =~ $get_pattern ]]; then
  remote_name="${BASH_REMATCH[1]##*/}"
  download_target="${BASH_REMATCH[2]}"
  download_target="${download_target//\\\"/\"}"
  download_target="${download_target//\\\\/\\}"
  # A completed CSV must not be visible while the transfer is in progress.
  final_target="$(dirname -- "$(dirname -- "$download_target")")/$remote_name"
  if [[ -e "$final_target" ]]; then
    echo "Mock detected premature publication: $final_target" >&2
    exit 99
  fi
  printf 'partial download\n' > "$download_target"
  if [[ "${MOCK_SFTP_INTERRUPT_DOWNLOAD:-0}" == 1 ]]; then
    kill -TERM "$PPID"
    exit 143
  fi
fi

failure_match="${MOCK_SFTP_FAIL_MATCH:-}"
if [[ -n "$failure_match" ]]; then
  arguments="$(printf '%s\n' "$@")"

  if [[ "$arguments" == *"$failure_match"* || "$input" == *"$failure_match"* ]]; then
    exit "${MOCK_SFTP_FAILURE_STATUS:-23}"
  fi
fi

list_processed() {
  local path
  [[ -d "$MOCK_STATE_DIR/monthly-remote/processed" ]] || return 1
  shopt -s nullglob
  for path in "$MOCK_STATE_DIR/monthly-remote/processed/"*; do
    printf '/monthly_report/processed/%s\n' "${path##*/}"
  done
}

rename_pattern='^@rename "/monthly_report/([^"]+)" "/monthly_report/processed/([^"]+)"$'
if [[ "$input" == '@ls -1 /monthly_report' ]]; then
  if [[ -f "$MOCK_STATE_DIR/monthly-listing" ]]; then
    while IFS= read -r entry || [[ -n "$entry" ]]; do
      name="${entry#/monthly_report/}"
      # Model a real listing: moved files no longer appear at the source.
      if [[ "$name" != */* && -e "$MOCK_STATE_DIR/monthly-remote/processed/$name" &&
        ! -e "$MOCK_STATE_DIR/monthly-remote/$name" ]]; then
        continue
      fi
      printf '%s\n' "$entry"
    done < "$MOCK_STATE_DIR/monthly-listing"
  fi
elif [[ "$input" == '@ls -1 "/monthly_report/processed/"' ]]; then
  list_processed
elif [[ "$input" == $'@mkdir "/monthly_report/processed"\n@ls -1 "/monthly_report/processed/"' ]]; then
  mkdir -- "$MOCK_STATE_DIR/monthly-remote/processed" && list_processed
elif [[ "$input" =~ $rename_pattern ]]; then
  source_name="${BASH_REMATCH[1]}"
  target_name="${BASH_REMATCH[2]}"
  if [[ ! -f "$TEST_PROJECT/data/monthly-reports/$source_name" ||
    -L "$TEST_PROJECT/data/monthly-reports/$source_name" ]]; then
    echo 'Mock detected remote move before local CSV publication' >&2
    exit 99
  fi
  if [[ "${MOCK_SFTP_INTERRUPT_MOVE:-0}" == 1 ]]; then
    kill -TERM "$PPID"
    exit 143
  fi
  mv -f -- "$MOCK_STATE_DIR/monthly-remote/$source_name" \
    "$MOCK_STATE_DIR/monthly-remote/processed/$target_name" || exit 1
  if [[ "${MOCK_SFTP_INTERRUPT_AFTER_MOVE:-0}" == 1 ]]; then
    kill -TERM "$PPID"
    exit 143
  fi
elif [[ -n "$download_target" ]]; then
  cp -- "$MOCK_STATE_DIR/monthly-remote/$remote_name" "$download_target"
else
  printf '%s\n' 'Mock sftp upload complete.'
fi
